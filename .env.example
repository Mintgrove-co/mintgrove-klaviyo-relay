# Your Mintgrove webhook signing secret, used to verify that incoming requests
# really came from Mintgrove.
# Mintgrove dashboard -> Settings -> Integrations -> Outbound webhook.
# Required: the relay rejects every request if this is not set.
MINTGROVE_SIGNING_SECRET=replace_me_with_your_signing_secret

# Copy this file to .env.local for local development, and set the same
# variable in your Vercel project settings for deployments.
# Never commit real credentials.
